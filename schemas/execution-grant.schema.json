{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/execution-grant.schema.json",
  "title": "JANUS MACHINE MARKET bounded execution grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_id", "purchase_id", "purchase_grant_hash", "sku", "request_hash", "status", "allowed_operation", "authority", "expires_at", "issued_by", "grant_hash"],
  "properties": {
    "schema": {"const": "janus.machine_market.execution_grant.v1"},
    "grant_id": {"type": "string", "minLength": 8},
    "purchase_id": {"type": "string", "minLength": 1},
    "purchase_grant_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "sku": {"const": "JANUS.SEARCH"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "status": {"const": "EXECUTION_GRANTED"},
    "allowed_operation": {"const": "JANUS.SEARCH.MARKET_CATALOG"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_scope", "max_results", "max_runtime_seconds", "network_access", "external_effects", "target_execution_performed"],
      "properties": {
        "source_scope": {"const": "MARKET_CATALOG"},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "network_access": {"const": false},
        "external_effects": {"const": false},
        "target_execution_performed": {"const": false}
      }
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by": {"type": "string", "minLength": 1},
    "grant_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
