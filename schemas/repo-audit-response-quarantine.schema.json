{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/repo-audit-response-quarantine.schema.json",
  "title": "JANUS Repository Audit Invalid Response Quarantine",
  "type": "object",
  "required": [
    "schema",
    "quarantine_id",
    "status",
    "source_repository",
    "source_branch",
    "home_source_commit",
    "source_filename",
    "source_content_bytes",
    "source_content_sha256",
    "reason_codes",
    "valid_response_selected",
    "delivery_receipt_created",
    "service_debt_closed",
    "quarantine_record_hash"
  ],
  "properties": {
    "schema": {"const": "janus.machine_market.repo_audit_response_quarantine.v1"},
    "quarantine_id": {"type": "string", "pattern": "^raq-[0-9a-f]{48}$"},
    "status": {"const": "REJECTED_BEFORE_SELECTION"},
    "source_repository": {"const": "Hawkar-usls/Hawkar-usls"},
    "source_branch": {"const": "janus/market-service-responses"},
    "home_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_filename": {"type": "string", "minLength": 1},
    "source_content_bytes": {"type": "integer", "minimum": 0},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_service_request_id": {"type": ["string", "null"], "maxLength": 256},
    "observed_service_request_id_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "valid_response_selected": {"const": false},
    "delivery_receipt_created": {"const": false},
    "service_debt_closed": {"const": false},
    "quarantine_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
