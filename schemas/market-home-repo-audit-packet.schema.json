{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/market-home-repo-audit-packet.schema.json",
  "title": "JANUS Machine Market HOME Repository Audit Packet",
  "type": "object",
  "required": ["schema", "packet_id", "created_at", "sku", "market_repository", "home_repository", "commerce_mode", "money_enabled", "purchase_grant", "purchase_grant_hash", "service_request", "service_request_hash", "command_authority_granted", "external_effect_authorized", "repository_write_authorized", "execute_repository_code", "packet_hash"],
  "properties": {
    "schema": {"const": "janus.machine_market.home_repo_audit_packet.v1"},
    "packet_id": {"type": "string", "pattern": "^rap-shadow-[0-9a-f]{48}$"},
    "created_at": {"type": "string", "minLength": 1},
    "sku": {"const": "JANUS.REPO_AUDIT"},
    "market_repository": {"const": "Hawkar-usls/JANUS-MACHINE-MARKET"},
    "home_repository": {"const": "Hawkar-usls/Hawkar-usls"},
    "commerce_mode": {"enum": ["ZERO_PRICE_SHADOW", "PAID_ERC20"]},
    "money_enabled": {"type": "boolean"},
    "payment_reference": {"type": ["string", "null"]},
    "purchase_grant": {"type": "object"},
    "purchase_grant_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_request": {"type": "object"},
    "service_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "return_route": {"type": ["object", "null"]},
    "command_authority_granted": {"const": false},
    "external_effect_authorized": {"const": false},
    "repository_write_authorized": {"const": false},
    "execute_repository_code": {"const": false},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
