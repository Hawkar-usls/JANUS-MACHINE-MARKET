{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/receipt.schema.json",
  "title": "JANUS MACHINE MARKET Result Receipt",
  "type": "object",
  "required": ["schema", "purchase_id", "sku", "request_sha256", "result_sha256", "status"],
  "properties": {
    "schema": {"const": "janus.machine_market.result_receipt.v1"},
    "purchase_id": {"type": "string", "minLength": 1},
    "sku": {"type": "string", "minLength": 1},
    "payment_reference": {"type": ["string", "null"]},
    "purchase_grant_hash": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "execution_grant_hash": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "status": {"enum": ["DELIVERED", "BLOCKED", "FAILED", "UNKNOWN_RESOURCE_LIMIT", "UNRESOLVED"]},
    "organ": {"type": ["string", "null"]},
    "runtime": {"type": ["object", "null"]},
    "resource_usage": {"type": ["object", "null"]},
    "price": {"type": ["object", "null"]},
    "settlement_reference": {"type": ["string", "null"]},
    "result_reference": {"type": ["string", "null"]},
    "inline_result": {},
    "execution_receipt": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
