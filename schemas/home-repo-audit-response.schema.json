{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/home-repo-audit-response.schema.json",
  "title": "JANUS HOME Repository Audit Response",
  "type": "object",
  "required": [
    "schema",
    "sku",
    "packet_id",
    "packet_hash",
    "purchase_id",
    "purchase_grant_hash",
    "service_request_id",
    "service_request_hash",
    "resident_uuid",
    "model_digest",
    "file_fabric_digest",
    "runtime_receipt_hash",
    "home_service_receipt_hash",
    "audit_result_hash",
    "audit_result",
    "same_resident_uuid",
    "return_home_verified",
    "command_authority_granted",
    "external_effect_authorized",
    "repository_write_authorized",
    "repository_code_executed",
    "security_certification_granted",
    "legal_opinion_granted",
    "home_response_hash"
  ],
  "properties": {
    "schema": {"const": "janus.machine_market.home_repo_audit_response.v1"},
    "sku": {"const": "JANUS.REPO_AUDIT"},
    "packet_id": {"type": "string", "pattern": "^rap-shadow-[0-9a-f]{48}$"},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purchase_id": {"type": "string", "pattern": "^pur-ra-shadow-[0-9a-f]{32}$"},
    "purchase_grant_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_request_id": {"type": "string", "pattern": "^ra-shadow-[0-9a-f]{48}$"},
    "service_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resident_uuid": {"type": "string", "minLength": 1},
    "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_fabric_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "home_service_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "same_resident_uuid": {"const": true},
    "return_home_verified": {"const": true},
    "command_authority_granted": {"const": false},
    "external_effect_authorized": {"const": false},
    "repository_write_authorized": {"const": false},
    "repository_code_executed": {"const": false},
    "security_certification_granted": {"const": false},
    "legal_opinion_granted": {"const": false},
    "home_response_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_result": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "request_id",
        "request_hash",
        "sku",
        "target",
        "authority",
        "bounds",
        "architecture_map",
        "license_observations",
        "risk_register",
        "result_hash"
      ],
      "properties": {
        "schema": {"const": "janus.market_service.repo_audit_result.v1"},
        "status": {"const": "BOUNDED_REPOSITORY_AUDIT_COMPLETE"},
        "request_id": {"type": "string", "pattern": "^ra-shadow-[0-9a-f]{48}$"},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sku": {"const": "JANUS.REPO_AUDIT"},
        "target": {
          "type": "object",
          "required": ["repository", "requested_ref", "resolved_commit_sha", "tree_sha"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "requested_ref": {"type": "string", "minLength": 1, "maxLength": 200},
            "resolved_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "additionalProperties": true
        },
        "authority": {
          "type": "object",
          "required": [
            "read_only",
            "repository_write",
            "repository_code_executed",
            "command_authority_granted",
            "claim_authority_granted",
            "scientific_evidence_authority_granted",
            "world_truth_authority_granted",
            "external_effect_authorized"
          ],
          "properties": {
            "read_only": {"const": true},
            "repository_write": {"const": false},
            "repository_code_executed": {"const": false},
            "command_authority_granted": {"const": false},
            "claim_authority_granted": {"const": false},
            "scientific_evidence_authority_granted": {"const": false},
            "world_truth_authority_granted": {"const": false},
            "external_effect_authorized": {"const": false}
          },
          "additionalProperties": true
        },
        "bounds": {
          "type": "object",
          "required": ["observed_tree_entries"],
          "properties": {
            "observed_tree_entries": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "architecture_map": {
          "type": "object",
          "required": ["has_tests", "has_ci"],
          "properties": {
            "has_tests": {"type": "boolean"},
            "has_ci": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "license_observations": {
          "type": "object",
          "required": ["license_file_observed"],
          "properties": {
            "license_file_observed": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "risk_register": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:-]{0,127}$"}
            },
            "additionalProperties": true
          }
        },
        "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
