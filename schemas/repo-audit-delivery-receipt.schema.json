{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/JANUS-MACHINE-MARKET/schemas/repo-audit-delivery-receipt.schema.json",
  "title": "JANUS Repository Audit Delivery Receipt",
  "type": "object",
  "required": [
    "schema",
    "sku",
    "purchase_id",
    "service_request_id",
    "service_request_hash",
    "packet_hash",
    "home_response_hash",
    "home_service_receipt_hash",
    "audit_result_hash",
    "resident_uuid",
    "resolved_commit_sha",
    "tree_sha",
    "home_source_commit",
    "home_response_path",
    "home_response_git_blob_sha",
    "source_issue_number",
    "result_return_fields_validated",
    "result_return_ready",
    "verified_buyer_delivery",
    "service_debt_closed",
    "repository_code_executed",
    "external_effect_authorized",
    "security_certification",
    "legal_opinion",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "janus.machine_market.repo_audit_delivery_receipt.v1"},
    "sku": {"const": "JANUS.REPO_AUDIT"},
    "purchase_id": {"type": "string", "pattern": "^pur-ra-shadow-[0-9a-f]{32}$"},
    "service_request_id": {"type": "string", "pattern": "^ra-shadow-[0-9a-f]{48}$"},
    "service_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "home_response_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "home_service_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resident_uuid": {"type": "string", "minLength": 1},
    "resolved_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "home_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "home_response_path": {"type": "string", "pattern": "^\\.janus/market-service-responses/ra-shadow-[0-9a-f]{48}\\.repo-audit-result\\.json$"},
    "home_response_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_issue_number": {"type": "integer", "minimum": 1},
    "result_return_fields_validated": {"const": true},
    "result_return_ready": {"const": true},
    "verified_buyer_delivery": {"const": true},
    "service_debt_closed": {"const": true},
    "repository_code_executed": {"const": false},
    "external_effect_authorized": {"const": false},
    "security_certification": {"const": false},
    "legal_opinion": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
