  ],
  "laws": [
    "A2A_GATEWAY != JANUS_SEARCH_EXECUTION",
    "A2A_DISCOVERY != FOREIGN_AGENT_WITNESS",
    "CALLER_GITHUB_IDENTITY_MUST_NOT_BE_REPLACED_BY_GATEWAY_IDENTITY",
