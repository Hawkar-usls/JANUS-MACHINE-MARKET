    "outputs": [
      "verdict",
      "score_0_100",
      "metrics",
      "failures",
      "warnings",
      "trace_sha256",
      "policy_sha256",
      "result_sha256"
    ]
  },
  "current_checks": [
    "CONTIGUOUS_EVENT_SEQUENCE",
    "TOOL_ALLOWLIST",
    "EXTERNAL_EFFECT_AUTHORITY",
    "RAW_TOOL_ARGUMENT_REJECTION",
    "DUPLICATE_CALL_ID",
    "ORPHAN_TOOL_RESULT",
    "MISSING_TOOL_RESULT",
    "REPEATED_IDENTICAL_TOOL_CALL_LOOP_SIGNAL",
    "TOOL_RESULT_PROVENANCE",
    "FINAL_PROVENANCE",
    "FINAL_RECEIPT",
    "EVENT_AND_TOOL_BUDGETS"
  ],
  "pricing": {
    "mode": "REFERENCE_ONLY_NOT_LIVE",
    "billing_unit": "trace_audit",
    "preview_unit_usdt_micros": 100000,
    "payable_quote": false
  },
  "execution": {
    "executor": "runtime/agent_eval.py",
    "public_live": false,
    "owner_shadow": true,
    "paid_execution": false,
    "blocker": "PUBLIC_AGENT_TRACE_INGRESS_PLUS_PRIVACY_TERMS_PLUS_END_TO_END_MARKET_RECEIPT"
  },
  "authority": {
    "payment_is_authority": false,
    "external_effect_authority": false,
    "customer_trace_is_world_truth": false,
    "semantic_correctness_authority": false
  },
  "truth_boundary": [
    "TRACE_AUDIT != SEMANTIC_CORRECTNESS_PROOF",
    "PASS != AGENT_SAFE_IN_ALL_ENVIRONMENTS",
    "SELF_REPORTED_TRACE != INDEPENDENT EXECUTION WITNESS",
    "OBSERVABILITY != EVALUATION_COMPLETENESS",
    "PAYMENT != EXECUTION_AUTHORITY"
  ]
}
