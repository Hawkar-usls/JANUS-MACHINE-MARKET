    "JANUS.COMPUTE": "CLOSED_TARGET_EXECUTION_WITNESS_PENDING"
  },
  "laws": [
    "DISCOVERY != PURCHASE",
    "REQUEST != PURCHASE",
    "PAYMENT != AUTHORITY",
    "NO_PAYMENT_BEFORE_FOREIGN_AGENT_WITNESS",
    "FOREIGN_AGENT_WITNESS_REQUIRES_EXTERNAL_PRINCIPAL",
    "FOREIGN_AGENT_WITNESS_REQUIRES_MACHINE_DISCOVERY_CLAIM",
    "GLOBAL_A2A_REGISTRY_DISCOVERY != A2A_RUNTIME",
    "GLOBAL_A2A_REGISTRY_LISTING != FOREIGN_AGENT_WITNESS",
    "PAID_PROMOTION_REQUIRES_PERSISTENT_HOME_RESULT",
    "SELF_OWNER_REQUEST != FOREIGN_AGENT_WITNESS",
    "SYNTHETIC_REQUEST != FOREIGN_AGENT_WITNESS",
    "LOCAL_CATALOG_EXECUTION != PERSISTENT_HOME_WITNESS",
    "WITNESS_RECEIPT != MONEY_AUTHORITY",
    "ONE_REQUEST_IDENTITY <= ONE_EXECUTION_IDENTITY",
    "JANUS.INFERENCE_REMAINS_CLOSED",
    "JANUS.COMPUTE_REMAINS_CLOSED"
  ],
  "next_gate": "FIRST_REAL_EXTERNAL_MACHINE_PUBLIC_SEARCH_PERSISTENT_HOME_RECEIPT"
}
