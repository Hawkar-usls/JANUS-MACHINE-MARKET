{
  "schema": "janus.machine_market.foreign_agent_witness_policy.v1",
  "status": "PREPARED_PENDING_REAL_EXTERNAL_REQUEST",
  "purpose": "Admit the first external machine-discovery/request witness only when the requester is observably independent from the repository owner under the GitHub event trust surface and the request completes through persistent JANUS HOME/HRAiN. Global A2A Registry discovery may identify how the external machine found JANUS, but registry presence never substitutes for the persistent HOME witness and never proves an A2A runtime.",
  "owner": {
    "login": "Hawkar-usls",
    "github_user_id": 242020399
  },
  "accepted_ingress": {
    "event": "issues.opened|issues.edited|issues.reopened",
    "title_prefix": "[JANUS FOREIGN MACHINE REQUEST]",
    "request_marker": "JANUS_MACHINE_REQUEST_JSON",
    "discovery_marker": "JANUS_DISCOVERY_WITNESS_JSON"
  },
  "persistent_home_promotion_ingress": {
    "event": "issues.opened",
    "title_prefix": "[JANUS R1B BUYER QUERY SHADOW]",
    "request_marker": "JANUS_BUYER_QUERY_SHADOW_JSON",
    "discovery_marker": "JANUS_DISCOVERY_WITNESS_JSON",
    "server_normalized_request_origin": "FOREIGN_PUBLIC_ZERO_PRICE_BETA",
    "claim_must_be_frozen_on_initial_issue_open": true,
    "public_admission_receipt_required": true,
    "credentialless_home_pull_required": true,
    "persistent_home_response_required": true,
    "hrain_bound_result_required": true,
    "legacy_local_catalog_witness_sufficient_for_paid_promotion": false
  },
  "independence_gate": {
    "requester_login_must_differ_from_owner": true,
    "requester_numeric_id_must_differ_from_owner": true,
    "requester_type_must_not_be_bot": true,
    "accepted_author_association": [
      "NONE",
      "FIRST_TIMER",
      "FIRST_TIME_CONTRIBUTOR"
    ],
    "owner_or_collaborator_association_rejected": true,
    "requester_attests_not_owner_controlled": true,
    "scope_note": "This proves an external GitHub principal under observable platform identity/association signals. It does not claim metaphysical proof that two accounts can never share an ultimate controller."
  },
  "required_discovery_claim": {
    "schema": "janus.machine_market.foreign_discovery_claim.v1",
    "allowed_surfaces": [
      "GLOBAL_A2A_REGISTRY",
      "GITHUB_PAGES",
      "GITHUB_REPOSITORY",
      "LLMS_TXT",
      "BEACON_JSON",
      "AGENT_MARKET_JSON",
      "CATALOG_JSON"
    ],
    "independent_from_owner": true,
    "machine_client": true
  },
  "discovery_surface_semantics": {
    "GLOBAL_A2A_REGISTRY": {
      "acceptable_as_frozen_discovery_source": true,
      "requires_registry_listing_to_have_been_observable_to_requester": true,
      "proves_a2a_runtime": false,
      "proves_execution": false,
      "proves_purchase_authority": false,
      "note": "The claim records where an independent machine says it discovered JANUS. A registry listing is discovery evidence only."
    }
  },
  "execution": {
    "sku": "JANUS.SEARCH",
    "price": 0,
    "currency": "NONE",
    "money_enabled": false,
    "autonomous_purchase_declared": false,
    "external_effects": false,
    "repository_write_by_buyer": false,
    "arbitrary_shell": false,
    "secret_access": false,
    "same_bounded_r1_runtime": true,
    "persistent_state_branch": "janus/market-state"
  },
  "persistent_receipt": {
    "legacy_schema": "janus.machine_market.foreign_agent_witness_receipt.v1",
    "paid_promotion_schema": "janus.machine_market.persistent_home_foreign_agent_witness_receipt.v1",
    "legacy_path_template": "state/r1-foreign/receipts/{witness_id}.json",
    "paid_promotion_path_template": "state/r1-foreign-home/receipts/{witness_id}.json",
    "first_paid_promotion_witness": "state/r1-foreign-home/FIRST.json",
    "immutable": true,
    "binds": [
      "repository_id",
      "issue_id",
      "issue_number",
      "requester_login",
      "requester_github_user_id",
      "author_association",
      "discovery_claim_hash",
      "public_admission_packet_hash",
      "request_hash",
      "query_id",
      "purchase_id",
      "purchase_grant_hash",
      "persistent_home_response_hash",
      "resident_uuid",
      "hrain_context_receipt_hash",
      "execution_identity",
      "response_hash"
    ]
  },
  "promotion_law": {
    "FOREIGN_AGENT_WITNESS": "PENDING_UNTIL_PERSISTENT_EXTERNAL_HOME_RECEIPT",
    "owner_self_request_can_promote": false,
    "workflow_dispatch_can_promote": false,
    "synthetic_fixture_can_promote": false,
    "payment_can_promote": false,
    "registry_listing_alone_can_promote": false,
    "legacy_local_catalog_witness_can_open_money": false,
    "only_qualifying_external_machine_public_search_persistent_home_roundtrip_can_promote_paid_commerce": true,
    "witness_receipt_itself_enables_money": false,
    "separate_canonical_promotion_required": true
  },
  "closed_skus": {
